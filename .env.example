# SQLite path is resolved relative to the prisma/ directory.
DATABASE_URL="file:../data/first-contact.db"

# demo uses the local hypothesis engine.
# openai uses an OpenAI-compatible chat completions endpoint.
# If AI_PROVIDER=openai but OPENAI_API_KEY is empty, the app stays in demo mode.
# A live experiment plan also requires the facilitator to confirm sharing.
# Only evidence with analysis consent is included. Media bytes are not sent for planning.
# A failed live plan is not replaced with a demo plan.
AI_PROVIDER="demo"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# Optional. When set, and a participant consents, wav or mp3 audio can be sent for acoustic description.
# The prompt forbids translation and invented phonemes. Leave empty to store audio without sending it.
OPENAI_AUDIO_MODEL=""
AI_TIMEOUT_MS="25000"

# Development uses local files. Preview and Production on Vercel use a private Supabase bucket.
# Use a different Supabase project for Preview than for Production.
# Never put the service-role key in a NEXT_PUBLIC variable.
STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="session-media"

# Signs media URLs. Required for Preview and Production, at least 16 characters.
# Local SQLite uses a built-in development key when this is empty.
MEDIA_SIGNING_SECRET=""
# Private media links expire after this many seconds. Default 900. Polling refreshes them.
# MEDIA_URL_TTL_SECONDS="900"

# Preview and Production only. Leave DIRECT_URL unset while DATABASE_URL is SQLite.
# DATABASE_URL: Supabase transaction pooler, port 6543, with ?pgbouncer=true&connection_limit=1
# DIRECT_URL: Supabase direct connection, port 5432. Prisma migrate uses this and not the pooler.
# DIRECT_URL=""

# Optional. stream keeps the local server-sent session feed. poll is forced on Vercel.
# SYNC_TRANSPORT=""

# Demo reset and demo seat issuance stay off unless every local condition is true:
# ALLOW_DEMO_OPERATOR=1, DEMO_OPERATOR_SECRET is at least 24 characters, and the app is not on Vercel preview or production.
# The secret is a request header, x-demo-operator. Do not put it in a NEXT_PUBLIC variable or in browser code.
# ALLOW_DEMO_OPERATOR=""
# DEMO_OPERATOR_SECRET=""
# DEMO_OPERATOR_DISABLED=""
# Recovery keys issued after this change expire. Default 168 hours. Legacy plaintext keys keep working until leave or rejoin replaces them.
# RECOVERY_TOKEN_TTL_HOURS="168"
# A demo seat credential expires sooner. Default 120 minutes.
# DEMO_ENTRY_TTL_MINUTES="120"

# Upload limits in bytes.
MAX_IMAGE_BYTES="8000000"
MAX_AUDIO_BYTES="10000000"
MAX_VIDEO_BYTES="25000000"

# Distributed rate limiting (never uses in-memory storage).
# RATE_LIMIT_STORE: "auto" (uses Redis REST when configured, otherwise atomic database buckets), "database", or "redis".
RATE_LIMIT_STORE="auto"
# Optional Upstash Redis / Vercel KV REST credentials. When omitted, atomic database buckets (RateLimitBucket) are used.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# Configurable action limits (defaults shown).
# RATE_LIMIT_SESSION_CREATE_MAX="20"
# RATE_LIMIT_SESSION_CREATE_WINDOW_SEC="900"
# RATE_LIMIT_SESSION_JOIN_MAX="30"
# RATE_LIMIT_SESSION_JOIN_WINDOW_SEC="900"
# RATE_LIMIT_SESSION_REJOIN_MAX="20"
# RATE_LIMIT_SESSION_REJOIN_WINDOW_SEC="900"
# RATE_LIMIT_EVIDENCE_UPLOAD_MAX="60"
# RATE_LIMIT_EVIDENCE_UPLOAD_WINDOW_SEC="900"
# RATE_LIMIT_AI_MAX="40"
# RATE_LIMIT_AI_WINDOW_SEC="900"
