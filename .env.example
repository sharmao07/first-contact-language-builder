# SQLite path is resolved relative to the prisma/ directory.
DATABASE_URL="file:../data/first-contact.db"

# demo uses the local hypothesis engine.
# openai uses an OpenAI-compatible chat completions endpoint.
# If AI_PROVIDER=openai but OPENAI_API_KEY is empty, the app stays in demo mode.
AI_PROVIDER="demo"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# Optional. When set, and a participant consents, wav or mp3 audio can be sent for acoustic description.
# The prompt forbids translation and invented phonemes. Leave empty to store audio without sending it.
OPENAI_AUDIO_MODEL=""
AI_TIMEOUT_MS="25000"

# local keeps files in data/uploads. supabase uses a private Storage bucket.
# Do not put the service-role key in a NEXT_PUBLIC variable.
STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="session-media"

# Postgres production. Leave these unset for SQLite.
# DATABASE_URL is the pooled Supabase URL. DIRECT_URL is the direct connection.
# DIRECT_URL=""

# Upload limits in bytes.
MAX_IMAGE_BYTES="8000000"
MAX_AUDIO_BYTES="10000000"
MAX_VIDEO_BYTES="25000000"
